# =============================================================================
# Euodoo Hire — Example Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env or any file containing real secrets to version control.
# =============================================================================

# --- MongoDB (production = MongoDB Atlas) ---
# Local development:
#MONGODB_URI=mongodb://localhost:27017/euodoo_hire
# Production (MongoDB Atlas). URL-encode the password. Keep euodoo_hire as the
# database (the app's existing collections live there). Recommended timeouts:
#MONGODB_URI=mongodb+srv://hireeuodoo_db_user:YOUR_PASSWORD_HERE@euodoo.bvqcqwt.mongodb.net/euodoo_hire?retryWrites=true&w=majority&serverSelectionTimeoutMS=10000&connectTimeoutMS=10000&socketTimeoutMS=60000
# Optional explicit database name (matches the URI database normally):
#MONGODB_DATABASE=euodoo_hire

# --- Razorpay ---
# Get these from your Razorpay Dashboard > Settings > API Keys
RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_YOUR_KEY_SECRET

# --- Cloudinary ---
# Values for this deployment are entered in the hosting secret store:
#   CLOUDINARY_CLOUD_NAME = harr8z32          (cloud name is public)
#   CLOUDINARY_API_KEY    = 422419663628695  (not a secret on its own)
#   CLOUDINARY_API_SECRET = secret — set only in the deployment environment
# This file contains placeholders only; never commit real values.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=REPLACE_WITH_YOUR_API_SECRET

# --- Local disk fallback storage (only used when Cloudinary is not configured) ---
APP_STORAGE_DIR=REPLACE_WITH_ABSOLUTE_UPLOAD_DIR
APP_STORAGE_SIGNING_SECRET=REPLACE_WITH_A_LONG_RANDOM_VALUE

# --- CORS (production) ---
CORS_ALLOWED_ORIGINS=https://your-production-domain

# --- Development ---
# Required only when spring.profiles.active=dev
DEV_ADMIN_PASSWORD=DevAdmin@2024!

# --- Subscriptions ---
# Configurable duration in days (default 30)
RECRUITER_SUBSCRIPTION_DAYS=30
CANDIDATE_SUBSCRIPTION_DAYS=30

